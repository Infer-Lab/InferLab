{
  "protocol_version": "11",
  "endpoint": {
    "protocol": "http",
    "host": "127.0.0.1",
    "port": 8000,
    "completions_path": "/v1/completions",
    "chat_completions_path": "/v1/chat/completions",
    "server_metrics": null
  },
  "model": {
    "locator": "/models/qwen3-vl",
    "served_name": "qwen3-vl"
  },
  "definition": {
    "request_source": {
      "kind": "random",
      "input_tokens": 512,
      "output_tokens": 128,
      "images": {
        "width": 512,
        "height": 384,
        "count": 2,
        "source": {
          "path": "images/pool",
          "resolved_path": "/workspace/images/pool",
          "expected_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "sampling": "shuffle-cycle"
        }
      }
    },
    "prompt": {
      "kind": "server_chat",
      "request_representation": "structured_messages",
      "route": "chat_completions",
      "rendering_authority": "server"
    },
    "server_metrics": false,
    "seed": 7,
    "cache_start": "uncontrolled",
    "timeout_seconds": 120
  },
  "case": {
    "load_shape": {
      "kind": "concurrency_limited",
      "concurrency": 4
    },
    "request_count": 16,
    "warmup_request_count": 4
  },
  "case_budget_seconds": 120.0,
  "artifact_dir": "artifacts"
}
