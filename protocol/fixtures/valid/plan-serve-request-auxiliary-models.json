{
  "operation": "plan_serve",
  "protocol_version": "11",
  "input": {
    "model": {
      "id": "deepseek-v4-flash",
      "served_name": "deepseek-v4-flash"
    },
    "topology": "single",
    "state_dir": ".inferlab",
    "roles": [
      {
        "id": "serve",
        "kind": "serve",
        "replica_count": 1,
        "parallelism": {
          "outer": {
            "tensor_parallel_size": 2
          }
        },
        "settings": {
          "extra_args": [
            "--speculative-config",
            "{\"method\":\"dspark\",\"num_speculative_tokens\":2}"
          ]
        }
      }
    ],
    "auxiliary_models": [
      {
        "kind": "draft-model",
        "model": {
          "id": "deepseek-v4-flash-draft",
          "served_name": "deepseek-v4-flash-draft"
        }
      }
    ]
  }
}
