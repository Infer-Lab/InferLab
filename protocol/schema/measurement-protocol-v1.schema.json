{
  "$id": "https://inferlab.dev/schema/measurement-protocol/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeasurementProtocol",
  "description": "The schema root aggregating the request and result surfaces used by the\nproduct-owned Eval and Bench measurement clients. Its optional fields are\ncode-generation anchors and are never all populated in one message.",
  "type": "object",
  "properties": {
    "bench_client_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchClientRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "bench_client_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchClientResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "bench_dataset_preparation_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchDatasetPreparationRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "bench_dataset_preparation_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchDatasetPreparationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "eval_client_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvalClientRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "eval_client_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvalClientResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$comment": "Generated from crates/inferlab-protocol/src/wire.rs; do not edit.",
  "additionalProperties": false,
  "$defs": {
    "BenchCaseInput": {
      "description": "A single Bench case: its load shape and the number of requests to send.",
      "type": "object",
      "properties": {
        "load_shape": {
          "$ref": "#/$defs/BenchLoadInput"
        },
        "request_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "warmup_request_count": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "load_shape",
        "request_count"
      ]
    },
    "BenchClientRequest": {
      "description": "The request the Bench measurement runtime passes to its client: the\nendpoint, model, bench definition, the load case to run, and the artifact\ndirectory.",
      "type": "object",
      "properties": {
        "artifact_dir": {
          "type": "string"
        },
        "case": {
          "$ref": "#/$defs/BenchCaseInput"
        },
        "case_budget_seconds": {
          "description": "Remaining control-plane case budget when the client is released.",
          "type": "number",
          "format": "double"
        },
        "definition": {
          "$ref": "#/$defs/BenchDefinitionInput"
        },
        "endpoint": {
          "$ref": "#/$defs/ClientEndpointInput"
        },
        "model": {
          "$ref": "#/$defs/MeasurementModelInput"
        },
        "population": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchPopulationInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "endpoint",
        "model",
        "definition",
        "case",
        "case_budget_seconds",
        "artifact_dir"
      ]
    },
    "BenchClientResult": {
      "description": "The result a Bench client writes for the measurement runtime to consume.",
      "type": "object",
      "properties": {
        "completed_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "failed_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "native_command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "normalization_schema": {
          "type": "string"
        },
        "raw_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawArtifact"
          }
        },
        "request_slo": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchRequestSloResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "description": "Result envelope version; clients write `1`. The measurement runtime\nrejects a bench result whose version is not `1`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ClientStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "completed_requests",
        "failed_requests",
        "normalization_schema",
        "metrics",
        "native_command",
        "raw_artifacts"
      ]
    },
    "BenchDatasetCacheState": {
      "description": "Read-only cache state observed while resolving the Bench plan.",
      "type": "string",
      "enum": [
        "missing",
        "present"
      ]
    },
    "BenchDatasetCatalogInput": {
      "description": "Immutable release-catalog facts resolved by the Rust control plane.",
      "type": "object",
      "properties": {
        "cache_path": {
          "type": "string"
        },
        "cache_state": {
          "$ref": "#/$defs/BenchDatasetCacheState"
        },
        "license": {
          "type": "string"
        },
        "materialization_identity": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "source_format": {
          "type": "string"
        },
        "upstream_identity": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "upstream_identity",
        "url",
        "sha256",
        "source_format",
        "license",
        "cache_path",
        "cache_state",
        "materialization_identity"
      ]
    },
    "BenchDatasetInput": {
      "description": "Release-qualified public Bench datasets.",
      "type": "string",
      "enum": [
        "sharegpt"
      ]
    },
    "BenchDatasetPreparationRequest": {
      "description": "The bounded tokenizer-backed operation that materializes one dataset\npopulation before any Bench case starts.",
      "type": "object",
      "properties": {
        "artifact_dir": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/MeasurementModelInput"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "request_body": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SettingValue"
          },
          "default": {}
        },
        "request_source": {
          "$ref": "#/$defs/BenchRequestSourceInput"
        },
        "required_entries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "model",
        "request_source",
        "source_path",
        "required_entries",
        "seed",
        "artifact_dir"
      ]
    },
    "BenchDatasetPreparationResult": {
      "description": "Terminal result of dataset population materialization.",
      "type": "object",
      "properties": {
        "admitted_entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "candidate_entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ineligible_entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ineligible_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": {}
        },
        "input_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchTokenCountSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "materialization_identity": {
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchTokenCountSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "population": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchPopulationInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_entries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ClientStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "materialization_identity",
        "requested_entries",
        "candidate_entries",
        "admitted_entries",
        "ineligible_entries"
      ]
    },
    "BenchDefinitionInput": {
      "description": "The workload shape a Bench client drives, shared across its load cases.",
      "type": "object",
      "properties": {
        "request_body": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SettingValue"
          },
          "default": {}
        },
        "request_slo": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchRequestSloInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_source": {
          "$ref": "#/$defs/BenchRequestSourceInput"
        },
        "reset_prefix_cache": {
          "type": "boolean",
          "default": false
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request_source",
        "seed",
        "timeout_seconds"
      ]
    },
    "BenchLoadInput": {
      "description": "How a Bench case paces its requests.",
      "oneOf": [
        {
          "description": "A fixed number of in-flight requests.",
          "type": "object",
          "properties": {
            "concurrency": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "concurrency_limited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "concurrency"
          ]
        },
        {
          "description": "A target arrival rate, optionally shaped by a burstiness factor.",
          "type": "object",
          "properties": {
            "burstiness": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "request_rate_limited"
            },
            "request_rate": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "request_rate"
          ]
        },
        {
          "description": "All requests issued as fast as possible.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unbounded_request_rate"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "BenchPopulationInput": {
      "description": "One frozen dataset population consumed sequentially by every Bench case.",
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "tpot_applicable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "entries",
        "tpot_applicable"
      ]
    },
    "BenchPrefixSharingInput": {
      "description": "The effective split between one shared system-message prefix and each\nrequest's independently generated user suffix.",
      "type": "object",
      "properties": {
        "shared_prefix_ratio": {
          "type": "number",
          "format": "double"
        },
        "shared_prefix_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unique_suffix_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "shared_prefix_ratio",
        "shared_prefix_tokens",
        "unique_suffix_tokens"
      ]
    },
    "BenchRandomShapeInput": {
      "description": "One exact ISL/OSL pair and its relative categorical sampling weight.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "weight"
      ]
    },
    "BenchRequestSloInput": {
      "description": "Per-request latency bounds lowered to the release-owned Bench runner.",
      "type": "object",
      "properties": {
        "minimum_good_request_ratio": {
          "type": "number",
          "format": "double"
        },
        "request_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "tpot_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "ttft_ms": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum_good_request_ratio"
      ]
    },
    "BenchRequestSloResult": {
      "description": "File-bound request-SLO evidence derived from AIPerf profiling records.",
      "type": "object",
      "properties": {
        "good_request_ratio": {
          "type": "number",
          "format": "double"
        },
        "good_requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "goodput": {
          "type": "number",
          "format": "double"
        },
        "native_aggregate_good_request_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "native_aggregate_good_request_count_consistent": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "profiling_duration_seconds": {
          "type": "number",
          "format": "double"
        },
        "profiling_duration_source": {
          "type": "string"
        },
        "request_count_reconciled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "good_requests",
        "good_request_ratio",
        "goodput",
        "profiling_duration_seconds",
        "profiling_duration_source",
        "request_count_reconciled"
      ]
    },
    "BenchRequestSourceInput": {
      "description": "One closed request origin lowered by Inferlab for the Bench runtime.",
      "oneOf": [
        {
          "description": "AIPerf generates exact token-shape prompts from the release-pinned\nsynthetic generator.",
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "random"
            },
            "output_tokens": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "prefix_sharing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BenchPrefixSharingInput"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input_tokens",
            "output_tokens"
          ]
        },
        {
          "description": "AIPerf samples exact token-shape pairs from one seeded categorical\ndistribution.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "random_mixture"
            },
            "shapes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BenchRandomShapeInput"
              }
            },
            "total_weight": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "shapes",
            "total_weight"
          ]
        },
        {
          "description": "Inferlab materializes a release-catalog conversation snapshot before\nAIPerf starts.",
          "type": "object",
          "properties": {
            "catalog": {
              "$ref": "#/$defs/BenchDatasetCatalogInput"
            },
            "dataset": {
              "$ref": "#/$defs/BenchDatasetInput"
            },
            "kind": {
              "type": "string",
              "const": "dataset"
            },
            "max_input_tokens": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "dataset",
            "max_input_tokens",
            "catalog"
          ]
        }
      ]
    },
    "BenchTokenCountSummary": {
      "description": "Summary of the realized token counts. Exact per-entry values remain in the\npopulation evidence artifact.",
      "type": "object",
      "properties": {
        "maximum": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "format": "double"
        },
        "minimum": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum",
        "mean"
      ]
    },
    "ClientEndpointInput": {
      "description": "The public workload endpoint an Eval or Bench client connects to.",
      "type": "object",
      "properties": {
        "chat_completions_path": {
          "type": "string"
        },
        "completions_path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol",
        "host",
        "port",
        "completions_path",
        "chat_completions_path"
      ]
    },
    "ClientStatus": {
      "description": "The terminal outcome a measurement client reports.",
      "oneOf": [
        {
          "description": "The client completed its measurement successfully.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "The client did not complete successfully.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "EndpointProtocol": {
      "description": "The application protocol a workload endpoint speaks.",
      "oneOf": [
        {
          "description": "HTTP.",
          "type": "string",
          "const": "http"
        }
      ]
    },
    "EvalClientRequest": {
      "description": "The request the Eval measurement runtime passes to its client: the endpoint\nto hit, the model, the eval definition, and where to write artifacts.",
      "type": "object",
      "properties": {
        "artifact_dir": {
          "type": "string"
        },
        "case_budget_seconds": {
          "description": "Remaining control-plane case budget when the client is released.",
          "type": "number",
          "format": "double"
        },
        "definition": {
          "$ref": "#/$defs/EvalDefinitionInput"
        },
        "endpoint": {
          "$ref": "#/$defs/ClientEndpointInput"
        },
        "model": {
          "$ref": "#/$defs/MeasurementModelInput"
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "workspace_root": {
          "type": "string"
        },
        "workspace_source_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "workspace_root",
        "workspace_source_exclusions",
        "endpoint",
        "model",
        "definition",
        "case_budget_seconds",
        "artifact_dir"
      ]
    },
    "EvalClientResult": {
      "description": "The result an Eval client writes for the measurement runtime to consume.",
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalFailureKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalMetricGate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "native_command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "native_timed_out": {
          "type": "boolean",
          "default": false
        },
        "normalized_metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvalNormalizedMetric"
          },
          "default": {}
        },
        "raw_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawArtifact"
          }
        },
        "schema_version": {
          "description": "Result envelope version; clients write `1`. The measurement runtime\nrejects an eval result whose version is not `1`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/ClientStatus"
        },
        "trial_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvalTrialSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "metrics",
        "native_command",
        "raw_artifacts"
      ]
    },
    "EvalDefinitionInput": {
      "description": "The measurement an Eval client runs against the workload endpoint.",
      "oneOf": [
        {
          "description": "A single-prompt liveness check.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "openai_smoke"
            },
            "max_tokens": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "prompt": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "prompt",
            "max_tokens",
            "timeout_seconds"
          ]
        },
        {
          "description": "An lm-eval task run with a pass threshold on the chosen metric.",
          "type": "object",
          "properties": {
            "concurrency": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "few_shot": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "lm_eval"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "max_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "metric": {
              "type": "string"
            },
            "metric_filter": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "request_body": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/SettingValue"
              },
              "default": {}
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "task": {
              "$ref": "#/$defs/EvalTaskSourceInput"
            },
            "threshold": {
              "type": "number",
              "format": "double"
            },
            "timeout_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "trials": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "trials",
            "metric",
            "threshold",
            "timeout_seconds"
          ]
        }
      ]
    },
    "EvalFailureKind": {
      "description": "A typed Eval failure category preserved across the client boundary.",
      "type": "string",
      "enum": [
        "task_resolution",
        "probe_tokenizer",
        "probe_transport",
        "probe_http",
        "probe_malformed_response",
        "probe_generated_only_logprobs",
        "probe_tokenizer_alignment",
        "metric_normalization"
      ]
    },
    "EvalMetricComparison": {
      "description": "The threshold comparison selected from lm-eval's scoring direction.",
      "type": "string",
      "enum": [
        "at_least",
        "at_most"
      ]
    },
    "EvalMetricGate": {
      "description": "The effective threshold comparison for the configured primary metric.",
      "type": "object",
      "properties": {
        "comparison": {
          "$ref": "#/$defs/EvalMetricComparison"
        },
        "conclusion": {
          "$ref": "#/$defs/EvalMetricGateConclusion"
        },
        "metric": {
          "$ref": "#/$defs/EvalNormalizedMetric"
        },
        "threshold": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "metric",
        "threshold",
        "comparison",
        "conclusion"
      ]
    },
    "EvalMetricGateConclusion": {
      "description": "The terminal conclusion of an lm-eval metric threshold gate.",
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "EvalNormalizedMetric": {
      "description": "One finite lm-eval metric with its exact native provenance.",
      "type": "object",
      "properties": {
        "filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "higher_is_better": {
          "type": "boolean"
        },
        "metric": {
          "type": "string"
        },
        "native_metric_key": {
          "type": "string"
        },
        "source_identity": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_identity",
        "metric",
        "native_metric_key",
        "value",
        "higher_is_better"
      ]
    },
    "EvalTaskSourceInput": {
      "description": "The resolved lm-eval task source consumed by the release-owned Eval runner.",
      "oneOf": [
        {
          "description": "One individual task shipped by the pinned lm-eval runtime.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "built_in"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "One task closure shipped and identity-bound by the Inferlab release.",
          "type": "object",
          "properties": {
            "dataset_asset_sha256": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "bundled"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "prompt_asset_sha256": {
              "type": "string"
            },
            "scorer_sha256": {
              "type": "string"
            },
            "task_closure_sha256": {
              "type": "string"
            },
            "task_definition_sha256": {
              "type": "string"
            },
            "task_identity": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "task_identity",
            "path",
            "task_closure_sha256",
            "task_definition_sha256",
            "prompt_asset_sha256",
            "dataset_asset_sha256",
            "scorer_sha256"
          ]
        },
        {
          "description": "One validated workspace-local lm-eval YAML file.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "workspace_yaml"
