        "completed_trials",
        "request_failure_trials",
        "passed_trials",
        "per_trial_metric",
        "higher_is_better"
      ]
    },
    "MeasurementModelInput": {
      "description": "The model identity used by measurement clients. Unlike integration\nplanning, a benchmark client may need a controller-visible tokenizer\nlocator.",
      "type": "object",
      "properties": {
        "locator": {
          "type": "string"
        },
        "served_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "locator",
        "served_name"
      ]
    },
    "ProtocolVersion": {
      "description": "The shared protocol version used by framework integrations and release-owned\nmeasurement clients. The only accepted value is `7` (serialized as the\nstring `\"7\"`); a mismatch is rejected before lowering.",
      "oneOf": [
        {
          "description": "Protocol version 7.",
          "type": "string",
          "const": "7"
        }
      ]
    },
    "RawArtifact": {
      "description": "A raw output file a client produced, retained as workload evidence.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
