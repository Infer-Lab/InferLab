    "EvalTrialSummary": {
      "description": "Reconstructible aggregate counts for fixed outer Eval trials.",
      "type": "object",
      "properties": {
        "completed_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "higher_is_better": {
          "type": "boolean"
        },
        "issued_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pass_rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "passed_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "per_trial_filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "per_trial_metric": {
          "type": "string"
        },
        "request_failure_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requested_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unissued_trials": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
